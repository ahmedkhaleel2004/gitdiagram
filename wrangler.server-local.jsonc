{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The Next.js server again, without `placement`: it runs where the visitor
  // is, as every Worker does by default. The site's Worker (`SERVER_LOCAL`,
  // wrangler.jsonc) sends it what is long or memory-heavy: diagram runs, the
  // crons, and whatever loads the whole browse index (`runsWhereTheVisitorIs`
  // in src/lib/cloudflare-edge.ts has the list).
  //
  // A Worker isolate that passes 128 MB of memory is killed with everything
  // it is running. In `gitdiagram-server` every request of the site shares a
  // few isolates in one place; with the browse index loaded in them, the
  // cron that rewrites it, a sitemap render or a few diagram runs at once
  // tipped them over, and the streams and requests beside them died
  // (2026-10-02). Here each location has its own isolates and they run one
  // or two requests at a time.
  //
  // Everything else must stay identical to wrangler.server.jsonc (a test
  // compares the two).
  "name": "gitdiagram-server-local",
  "main": "cloudflare/server.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // See wrangler.jsonc.
  "keep_names": false,
  "workers_dev": false,
  "preview_urls": false,
  "limits": { "cpu_ms": 30000 },
  // As for the site's Worker: every request logged while the credits last.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // As for the site's Worker: failures are also logged by workers/errors.
  "tail_consumers": [{ "service": "gitdiagram-errors" }],
  "vars": {
    "INDEXNOW_ENABLED": "1",
    "SITE_ORIGIN": "https://gitdiagram.com",
  },
  // Only what server code reads through the ASSETS binding: the fonts of the
  // social pictures (src/server/og/cards.tsx). The site's own static files
  // are served by `gitdiagram`.
  "assets": {
    "directory": ".open-next/server-assets",
    "binding": "ASSETS",
    "html_handling": "none",
  },
  "services": [
    // Calls the app makes to itself (the revalidation queue, the container's
    // page refresh) enter through the site's Worker, as a visitor's would.
    { "binding": "WORKER_SELF_REFERENCE", "service": "gitdiagram" },
    // The server next to the data (itself, in wrangler.server.jsonc): a page
    // revalidated anywhere is dropped from its copies too
    // (src/lib/colo-cache.ts).
    { "binding": "PLACED_SERVER", "service": "gitdiagram-server" },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gitdiagram-next-cache",
    },
  ],
  // The Durable Objects live in the site's Worker. A class must exist there
  // before this Worker can bind it, and the deploy uploads this Worker first:
  // a new class has to ship in the site's Worker one deploy ahead of its
  // binding here.
  "durable_objects": {
    "bindings": [
      {
        "name": "NEXT_CACHE_DO_QUEUE",
        "class_name": "DOQueueHandler",
        "script_name": "gitdiagram",
      },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
        "script_name": "gitdiagram",
      },
      // Model API calls for visitors in countries OpenAI refuses
      // (cloudflare/us-relay.ts; src/server/model-fetch.ts asks for it).
      {
        "name": "US_RELAY",
        "class_name": "UsRelay",
        "script_name": "gitdiagram",
      },
    ],
  },
}
