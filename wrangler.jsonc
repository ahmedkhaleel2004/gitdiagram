{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site on Cloudflare Workers (OpenNext). Built by `bun run cf:build`.
  "name": "gitdiagram",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's name-keeping wraps functions in a `__name` helper, which breaks
  // server code that prints a function into an inline script (next-themes).
  "keep_names": false,
  "workers_dev": true,
  // The default is 30 s of CPU per request. Nothing here should come near
  // it (a page render is ~0.1 s), but a diagram run or the 8 MB sitemap must
  // never be cut off midway: allow the maximum.
  "limits": { "cpu_ms": 300000 },
  // Logs are sampled: at ~16M requests a month, every request logged would
  // cost more than the Worker itself.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.02,
  },
  // The crons vercel.json runs on Vercel (cloudflare/worker.ts maps each
  // schedule to its route; a test keeps the three files in step).
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "0 13 * * *"],
  },
  "vars": {
    // Where the cron handler and internal calls address the site.
    "SITE_ORIGIN": "https://gitdiagram.com",
  },
  // Vercel's four firewall rate limits (requests per minute per address);
  // cloudflare/worker.ts applies them before the app runs.
  "ratelimits": [
    {
      "name": "LIMIT_GENERATE_STREAM",
      "namespace_id": "4721",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "LIMIT_GENERATE_COST",
      "namespace_id": "4722",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_GENERATE_CANCEL",
      "namespace_id": "4723",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_DIAGRAM_STATE",
      "namespace_id": "4724",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve files under their own names: the default would redirect
    // /video-engine/stage.html to /video-engine/stage.
    "html_handling": "none",
  },
  "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "gitdiagram" }],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gitdiagram-next-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
  ],
}
