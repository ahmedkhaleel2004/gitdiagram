{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // The site on Cloudflare Workers (OpenNext). Built by `bun run cf:build`.
  // The site's Worker: the firewall, routing, the page cache, static files,
  // the render containers and the crons. The Next.js server is a Worker
  // behind it (wrangler.server.jsonc, wrangler.server-local.jsonc), and a
  // small one in front of it holds the routes (wrangler.edge.jsonc).
  "name": "gitdiagram",
  "main": "cloudflare/worker.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  // esbuild's name-keeping wraps functions in a `__name` helper, which breaks
  // server code that prints a function into an inline script (next-themes).
  "keep_names": false,
  "workers_dev": true,
  // CPU one request may use (it is billed by the millisecond). The most any
  // request used on the live site's first day was 4.9 s (a diagram run; the
  // 8 MB sitemap takes 2.8 s, a page render ~0.1 s), so 30 s cuts nothing
  // real off and bounds what a runaway request can cost.
  "limits": { "cpu_ms": 30000 },
  // Every request is logged while the startup credits last (to 2027-10-07).
  // At ~16M requests a month that costs more than the Worker itself: back to
  // 0.02 (as it was) before they run out.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  // Failures are also logged by a Tail Worker, which sees every request
  // whatever the sampling above (workers/errors; deploy it before the site).
  "tail_consumers": [{ "service": "gitdiagram-errors" }],
  // cloudflare/worker.ts maps each schedule to its internal route (CRON_ROUTES
  // in src/lib/cloudflare-edge.ts; a test keeps the two in step).
  "triggers": {
    "crons": ["*/5 * * * *", "*/15 * * * *", "0 13 * * *"],
  },
  // No routes here: gitdiagram.com/* and www.gitdiagram.com/* belong to the
  // small Worker in front of this one (`gitdiagram-edge`,
  // wrangler.edge.jsonc), which answers cached pages itself and passes the
  // rest on. This Worker is complete without it and still answers on
  // workers.dev; `node scripts/cf-routes.mjs gitdiagram` gives it the routes
  // back.
  "vars": {
    // Turns IndexNow pings on (off everywhere else).
    "INDEXNOW_ENABLED": "1",
    // Where the cron handler and internal calls address the site.
    "SITE_ORIGIN": "https://gitdiagram.com",
    // The render pool (workers/render): instances a film's segments spread
    // over, Chromium renders per instance, and how long an idle instance
    // stays awake (and billed) after its last request. RENDER_KEEP_AWAKE "1"
    // with RENDER_SLEEP_AFTER "12m" keeps the pool and the generation
    // instance awake for good (the five-minute cron touches each), so no
    // render waits 4 to 5 s for a start: about $230 a month of memory against
    // $12. It ran for an hour on 2026-10-07 and was switched off again until
    // an invoice shows the startup credits pay for Containers, which
    // Cloudflare's list of covered products does not name.
    "RENDER_POOL_SIZE": "5",
    // Five more, started only while all of the pool's are busy (several
    // renders at once); a lone render never wakes them.
    "RENDER_POOL_OVERFLOW": "5",
    "RENDER_SEGMENT_CONCURRENCY": "2",
    "RENDER_SLEEP_AFTER": "30s",
  },
  // MP4s, posters and video generation need headless Chromium and ffmpeg,
  // which a Worker cannot run: those three routes are handed to containers
  // that run this same site as a Node server (the repo's Dockerfile). The
  // deploy script replaces "./Dockerfile" below with the image in the
  // registry named after its contents, building it only when they changed
  // (scripts/cf-container-image.mjs), so most deploys leave the containers
  // alone.
  "containers": [
    {
      // The render pool. Two Chromiums and two encoders per instance, as on
      // Vercel (2 vCPU, 4 GB there); 6 GiB is the least Cloudflare allows
      // with 2 vCPU. Memory and disk bill while an instance is awake, so
      // five small instances that sleep when idle cost less than one big
      // one, and render a film about twice as fast.
      "class_name": "RenderContainer",
      "image": "./Dockerfile",
      "instance_type": { "vcpu": 2, "memory_mib": 6144, "disk_mb": 6000 },
      // The pool, its overflow, and one so a deploy can start a replacement.
      "max_instances": 11,
    },
    {
      // Video generation: minutes of waiting on model calls, a second of
      // ffmpeg. One instance serves every run. Ten runs at once (the cap)
      // use about 0.45 GiB and, on the smaller `basic` (1/4 vCPU), all of
      // its processor; this has twice that for about a dollar a month.
      "class_name": "GenerateContainer",
      "image": "./Dockerfile",
      "instance_type": "standard-1",
      "max_instances": 2,
    },
  ],
  // Vercel's four firewall rate limits (requests per minute per address);
  // cloudflare/worker.ts applies them before the app runs.
  "ratelimits": [
    {
      "name": "LIMIT_GENERATE_STREAM",
      "namespace_id": "4721",
      "simple": { "limit": 20, "period": 60 },
    },
    {
      "name": "LIMIT_GENERATE_COST",
      "namespace_id": "4722",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_GENERATE_CANCEL",
      "namespace_id": "4723",
      "simple": { "limit": 60, "period": 60 },
    },
    {
      "name": "LIMIT_DIAGRAM_STATE",
      "namespace_id": "4724",
      "simple": { "limit": 120, "period": 60 },
    },
    {
      // Starting a video or an MP4 wakes a container (see cloudflare-edge.ts).
      "name": "LIMIT_VIDEO_START",
      "namespace_id": "4725",
      "simple": { "limit": 30, "period": 60 },
    },
    {
      // A cost guard, not a Vercel rule: repository pages (and their social
      // pictures) one address may ask for in a minute. An uncached one costs
      // a render and two R2 writes.
      "name": "LIMIT_REPO_PAGE",
      "namespace_id": "4726",
      "simple": { "limit": 120, "period": 60 },
    },
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
    // Serve files under their own names: the default would redirect
    // /video-engine/stage.html to /video-engine/stage.
    "html_handling": "none",
  },
  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "gitdiagram" },
    // The Next.js server (wrangler.server.jsonc): what the routing layer and
    // the page cache in this Worker cannot answer.
    { "binding": "SERVER", "service": "gitdiagram-server" },
    // The same server where the visitor is, for what is long or heavy
    // (wrangler.server-local.jsonc says why).
    { "binding": "SERVER_LOCAL", "service": "gitdiagram-server-local" },
  ],
  "r2_buckets": [
    {
      "binding": "NEXT_INC_CACHE_R2_BUCKET",
      "bucket_name": "gitdiagram-next-cache",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" },
      {
        "name": "NEXT_TAG_CACHE_DO_SHARDED",
        "class_name": "DOShardedTagCache",
      },
      { "name": "RENDER", "class_name": "RenderContainer" },
      { "name": "GENERATE", "class_name": "GenerateContainer" },
      // Model API calls for visitors in countries OpenAI refuses
      // (cloudflare/us-relay.ts).
      { "name": "US_RELAY", "class_name": "UsRelay" },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DOQueueHandler", "DOShardedTagCache"],
    },
    {
      "tag": "v2",
      "new_sqlite_classes": ["RenderContainer", "GenerateContainer"],
    },
    { "tag": "v3", "new_sqlite_classes": ["UsRelay"] },
  ],
}
